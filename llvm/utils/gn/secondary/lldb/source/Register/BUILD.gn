static_library("Register") {
  output_name = "lldbRegister"
  configs += [ "//llvm/utils/gn/build:lldb_code" ]
  deps = [
    "//lldb/source/Utility",
    "//llvm/lib/Support",
    "//llvm/lib/TargetParser",
  ]
  include_dirs = [ "//lldb/source" ]
  sources = [
    "Common/RegisterInfo_arm.cpp",
    "Common/RegisterInfo_arm64.cpp",
    "Common/RegisterInfo_loongarch64.cpp",
    "Common/RegisterInfo_powerpc.cpp",
    "Common/RegisterInfo_ppc64.cpp",
    "Common/RegisterInfo_ppc64le.cpp",
    "Common/RegisterInfo_riscv32.cpp",
    "Common/RegisterInfo_riscv64.cpp",
    "Common/RegisterInfo_s390x.cpp",
    "Common/RegisterInfo_x86.cpp",
    "Layouts/FreeBSD/RegisterModelFreeBSD_arm.cpp",
    "Layouts/FreeBSD/RegisterModelFreeBSD_arm64.cpp",
    "Layouts/FreeBSD/RegisterModelFreeBSD_i386.cpp",
    "Layouts/FreeBSD/RegisterModelFreeBSD_powerpc.cpp",
    "Layouts/FreeBSD/RegisterModelFreeBSD_x86_64.cpp",
    "Layouts/Linux/RegisterModelLinux_arm.cpp",
    "Layouts/Linux/RegisterModelLinux_arm64.cpp",
    "Layouts/Linux/RegisterModelLinux_i386.cpp",
    "Layouts/Linux/RegisterModelLinux_loongarch64.cpp",
    "Layouts/Linux/RegisterModelLinux_ppc64le.cpp",
    "Layouts/Linux/RegisterModelLinux_riscv64.cpp",
    "Layouts/Linux/RegisterModelLinux_s390x.cpp",
    "Layouts/Linux/RegisterModelLinux_x86_64.cpp",
    "Layouts/NetBSD/RegisterModelNetBSD_i386.cpp",
    "Layouts/NetBSD/RegisterModelNetBSD_x86_64.cpp",
    "RegisterCodec.cpp",
    "RegisterDescription.cpp",
    "RegisterDescriptionBuilder.cpp",
    "RegisterInfoProvider.cpp",
    "RegisterLayout.cpp",
  ]
